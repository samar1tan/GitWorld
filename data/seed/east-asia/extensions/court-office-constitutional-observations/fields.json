  "semanticNotes": [
    {
      "ids": [
        "settlement:conceding-claim",
        "settlement:receiving-claim",
        "settlement:undertaking",
        "relation:political-settlement"
      ],
      "en": "A source-described settlement between imperial claims. The undertaking is a promise, not evidence of later fulfillment, a legitimacy judgment, state merger or Git ancestry.",
      "zh-CN": "来源记载的皇位主张之间的和议。和议条款是当时的承诺，不证明后来履行，不代表合法性裁判、国家合并或 Git 继承。"
    },
    {
      "ids": [
        "institution:replaced-office",
        "institution:established-office",
        "institution:cabinet-formation-date"
      ],
      "en": "The source explicitly reports an office replacement and a Cabinet formed on the same date. This does not backdate the later Cabinet constitutional-role object or establish institutional continuity.",
      "zh-CN": "来源明确记载官职替代及同日内阁形成，不据此回推后来的内阁宪制角色，也不据此确认机构连续性。"
    },
    {
      "ids": [
        "constitution:source-listed-head-of-state-provision",
        "constitution:premier-nominator",
        "constitution:observation-basis"
      ],
      "en": "Dated observations of the source’s constitutional-text comparison. None means that its “Head of state” row lists none; it is not an independent legal-text audit, absence of all state representation, enforcement timing or effective power. Explicit abolition/restoration use separate evidence.",
      "zh-CN": "对来源宪制文本比较的有日期观察。“未列”仅表示其“国家元首”行明确列为无，不是独立法条审校，也不表示没有任何国家代表、已经确定施行时间或实际权力。废除与恢复另有明确证据。"
    }
