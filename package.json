{
  "name": "gitworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node apps/desktop/build.mjs",
    "dev": "npm run build && electron apps/desktop",
    "test": "node scripts/test-workspaces.mjs",
    "typecheck": "node scripts/typecheck-workspaces.mjs",
    "audit:publication": "node scripts/publication-audit.mjs",
    "desktop:smoke": "node apps/desktop/smoke.mjs",
    "desktop:icon": "node apps/desktop/build-icon.mjs",
    "desktop:package": "npm run build && node apps/desktop/package.mjs",
    "desktop:package:internal": "npm run build && node apps/desktop/package.mjs --internal",
    "desktop:smoke:packaged": "node apps/desktop/smoke.mjs --packaged"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource/inter": "5.2.8",
    "@resvg/resvg-js": "2.6.2",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "d3-geo": "3.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
